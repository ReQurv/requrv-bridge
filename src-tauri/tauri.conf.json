{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ReQurv Bridge",
  "version": "0.2.3",
  "identifier": "ai.requrv.launch",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "bun run dev --port 3001 --bun",
    "beforeBuildCommand": "bun run build --bun"
  },
  "app": {
    "windows": [
      {
        "title": "ReQurv Bridge",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "Developer ID Application: REQURV SRL (9637365VXF)"
    },
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
